    ],
    "label": "vendor/Iluvatar",
    "gpu_check": "tools/gpu_check_iluvatar.sh",
    "label_gated": true,
    "prebuilt_env": true,
    "enabled": true,
    "container": {
      "image": "harbor.baai.ac.cn/flagos-runtime/flagos-runtime-iluvatar-corex4.5.0:2.2.0",
      "options": "--device /dev/iluvatar0 --device /dev/itrctl --shm-size=256g --ulimit memlock=-1 --ulimit stack=67108864",
      "runs_on": "flagtrain-iluvatar-bi-v150-0"
    }
  },
  {
