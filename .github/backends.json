[
  {
    "backend": "nvidia-cuda133",
    "vendor": "nvidia",
    "runner_label": "h20",
    "command_aliases": [
      "h20",
      "a100"
    ],
    "label": "vendor/NVIDIA",
    "gpu_check": "tools/gpu_check_nvidia.sh",
    "label_gated": false,
    "prebuilt_env": false,
    "enabled": true,
    "note": "Runs natively on the h20 runner: the job builds .github/docker/gpu-runner.Dockerfile there and runs pytest inside it, so there is no container: block and prebuilt_env does not apply."
  },
  {
    "backend": "ascend-cann900",
    "vendor": "ascend",
    "runner_label": "cann9",
    "command_aliases": [
      "ascend",
      "cann9"
    ],
    "label": "vendor/Ascend",
    "gpu_check": "tools/gpu_check_ascend.sh",
    "label_gated": true,
    "prebuilt_env": false,
    "enabled": true,
    "note": "Native, like FlagGems' ascend job: the cann9 runner's own process cannot reach /var/run/docker.sock, so a `container:` job never starts there (the runner fails at 'Checking docker version' before any step runs). No container block, so backend-test.yaml picks its native job, and setup_env.sh --no-prebuilt installs the CANN torch stack from backends.yaml into a job-local venv."
  },
  {
    "backend": "hygon",
    "vendor": "hygon",
    "runner_label": "hygon",
    "command_aliases": [
      "hygon"
    ],
    "label": "vendor/Hygon",
    "gpu_check": "tools/gpu_check_hygon.sh",
    "label_gated": true,
    "prebuilt_env": true,
    "enabled": true,
    "container": {
      "image": "harbor.baai.ac.cn/flagos-runtime/flagos-runtime-hygon-dtk26.04:2.2.0",
      "options": "--device /dev/kfd --device /dev/mkfd --device /dev/dri --group-add video --security-opt seccomp=unconfined --shm-size=256g --ulimit memlock=-1 --ulimit stack=67108864",
      "runs_on": "flagtrain-hygon-bw1000-0"
    }
  },
  {
    "backend": "iluvatar",
    "vendor": "iluvatar",
    "runner_label": "iluvatar",
